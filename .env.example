# Server-side only. Never prefix these names with NEXT_PUBLIC_.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Production storage. Leave empty in local development to use .data/seasonality-edge-db.json.
DATABASE_URL=

# Required by /api/cron/daily-refresh for Hostinger cron.
DATA_REFRESH_SECRET=

# Optional: defaults to the official detailed Dhan security-master endpoint.
DHAN_SECURITY_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv

# Google OAuth web client and NextAuth session configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
